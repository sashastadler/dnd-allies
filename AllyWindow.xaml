<Window x:Class="dnd_allies.AllyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ally Selection" Height="500" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Name -->
            <RowDefinition Height="Auto"/>  <!-- 1: Description/Image -->
            <RowDefinition Height="Auto"/>  <!-- 2: AC/HP -->
            <RowDefinition Height="Auto"/>  <!-- 3: Speed -->
            <RowDefinition Height="Auto"/>  <!-- 4: Immunities -->
            <RowDefinition Height="Auto"/>  <!-- 5: Innate -->
            <RowDefinition Height="*"/>     <!-- 6: Actions -->
            <RowDefinition Height="Auto"/>  <!-- 7: Apex -->
            <RowDefinition Height="Auto"/>  <!-- 8: Exit -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Standard ally information -->
        <TextBlock Name="NameTextBlock" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"
                Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap"/>
        <TextBlock Name="DescriptionTextBlock" Margin="10" Grid.Row="1" Grid.Column="0" TextWrapping="Wrap"/>
        <TextBlock Name="AcTextBlock" Margin="10" Grid.Row="2" Grid.Column="0"/>
        <TextBlock Name="SpeedTextBlock" Margin="10" Grid.Row="3" Grid.Column="0"/>
        <TextBlock Name="ImmunitiesTextBlock" Margin="10" Grid.Row="4" Grid.Column="0" TextWrapping="Wrap"/>

        <Image Name="AllyImage" Width="100" Height="100" HorizontalAlignment="Center" 
               Grid.Row="1" Grid.Column="1" Margin="5"/>

        <!-- HP tracker - Rows 2-4 -->
        <Border Name="HpBorder" Grid.Row="2" Grid.Column="1" Grid.RowSpan="3" BorderBrush="Gray" BorderThickness="2" 
                Margin="10" Padding="10">
            <StackPanel>
                <TextBlock Name="HpTextBlock" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBox Name="DamageInput" Width="100" Height="25" HorizontalAlignment="Center" 
                         Margin="5" Text="0"/>
                <Button Name="DamageButton" Content="Take Damage" Width="80" Height="30" 
                        HorizontalAlignment="Center" Margin="5" Click="DamageButton_Click" Foreground="Red"/>
                <Button Name="HealButton" Content="Heal" Width="80" Height="30" 
                        HorizontalAlignment="Center" Margin="5" Click="HealButton_Click" Foreground="Green"/>
            </StackPanel>
        </Border>

        <!-- Actions section - Row 6 -->
        <StackPanel Name="ActionsPanel" Grid.Row="6" Grid.ColumnSpan="2" Margin="10">
            <TextBlock Text="Actions" FontWeight="Bold" Margin="0,0,0,4"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                <ItemsControl Name="ActionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Name="btnExit" Content="Exit" Height="30" Width="100" 
                    Click="ExitButton_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
